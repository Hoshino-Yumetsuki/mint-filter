{
  "compilerOptions": {
    "incremental": true,
    "target": "esnext",
    "strict": true,
    "outDir": "dist/main",
    "rootDir": "src",
    "moduleResolution": "node",
    "module": "CommonJS",
    "declaration": true,
    "removeComments": true,
    "inlineSourceMap": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "typeRoots": ["node_modules/@types", "src/types"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "**/*.spec.ts", "**/*.test.ts"],
  "compileOnSave": false
}
